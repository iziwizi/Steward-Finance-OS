# ============================================================
# StewardOS Personal Finance — Environment Variables Example
# Copy this file to .env.local and fill in your values.
# NEVER commit real credentials or .env.local to Git.
# ============================================================

# 1. Supabase Authentication & PostgreSQL Database (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Automated Daily / Weekly / Monthly Digest Cron (Required for email & push digests)
# Generate a secure random string (e.g. openssl rand -hex 32)
CRON_SECRET=your-random-cron-secret-here

# 3. Gmail SMTP Digest Email Notifications (Required for email sending)
# Configure in Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME="StewardOS"

# 4. Web Push Notifications (Optional / Progressive Web App)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT="mailto:notifications@stewardos.app"

# 5. Application Domain (Optional - defaults to incoming host / Vercel URL)
NEXT_PUBLIC_SITE_URL=https://your-app-domain.com