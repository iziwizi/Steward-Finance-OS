# StewardOS Environment Variables Template (.env.example)
# Copy this file to .env.local for local development.
# In production, add these variables in Vercel Project Settings -> Environment Variables.

# Supabase Public Configuration (Client & Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server & Background Worker Key (Server-Only / Cron)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel Cron Security Secret (Used to authenticate /api/cron/digest)
CRON_SECRET=your-random-long-cron-secret-token

# Morning Daily Digest Email Delivery (Gmail SMTP + App Password)
# Generated in Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your-company-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME=StewardOS

# Web Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key