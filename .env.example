# StewardOS Environment Variables Template (.env.example)
# In production, configure these variables in Vercel Project Settings -> Environment Variables.

# Supabase Public Configuration (Client & Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server & Background Worker Key (Server-Only / Cron)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production Application Canonical URL (Used for auth email redirect and webhook callbacks)
NEXT_PUBLIC_APP_URL=https://steward-finance-os.vercel.app

# Resend Transactional Email Infrastructure (Verified Domain: mujteknify.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_NAME=StewardOS
EMAIL_FROM_ADDRESS=notifications@mujteknify.com

# Vercel Cron Security Secret (Used to authenticate /api/cron/digest and /api/cron/reminder)
CRON_SECRET=your-random-cryptographic-cron-secret

# Web Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:notifications@mujteknify.com