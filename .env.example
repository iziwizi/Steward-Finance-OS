# --- Supabase (public — safe in the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://dlknryxsmggqefolcips.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web Push (public key is safe in the browser; private key is server-only) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email (Gmail SMTP via App Password — server-only, never exposed to the client) ---
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
# Requires 2-Step Verification to be enabled on the Gmail account first.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Cron protection ---
# Any random string. Vercel automatically sends it as `Authorization: Bearer <value>`
# on requests it triggers once this is set as a Vercel env var — nothing else to configure.
CRON_SECRET=
